# Standard Flutter ignores — most of this doesn't exist yet (platform
# folders are generated by `flutter create`, see README.md) but is listed
# up front so nothing generated/build-only gets committed by accident.

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
*.log

# Platform build artifacts (the source folders themselves are fine to
# commit once generated — only their own build output is excluded).
android/.gradle/
android/app/build/
android/local.properties
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Pods/
ios/.symlinks/
ios/Runner.xcworkspace/xcshareddata/
ios/Runner/GeneratedPluginRegistrant.*
